# Trustwire Git Ignore Rules

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Electron & OS builds
desktop/dist/
*.exe
*.msi
*.zip
*.pptx
*.ppt

# Temporary media & security cache (STRICT PRIVACY)
temp_media/
alerts_store/*.json
!alerts_store/.gitkeep
models/**/*.onnx
models/**/*.safetensors
models/**/*.bin
models/**/.cache/
*.incomplete
.cache/


# Environment and secrets
.env
.env.local
*.log

# Windows Desktop
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
