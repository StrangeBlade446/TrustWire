# Trustwire Environment Configuration Template
# Copy to .env for custom configuration

# API Server Settings
TRUSTWIRE_HOST=127.0.0.1
TRUSTWIRE_PORT=8765

# Security Capability Token (Generated automatically if omitted)
TRUSTWIRE_API_TOKEN=your_secure_capability_token_here

# Privacy & Retention Configuration
# Maximum retention in seconds for temporary media (Default: 900s = 15 minutes)
TRUSTWIRE_MAX_RETENTION_SECONDS=900

# Whisper ASR Configuration (tiny, base, small)
TRUSTWIRE_WHISPER_MODEL=tiny
TRUSTWIRE_WHISPER_DEVICE=cpu
TRUSTWIRE_WHISPER_COMPUTE=int8

# Development Mode (Set to 1 to bypass capability token checks on localhost)
TRUSTWIRE_DEV_NO_AUTH=0
